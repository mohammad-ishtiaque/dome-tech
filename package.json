{
  "name": "dome-tech",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dome/api --filter @dome/web --filter @dome/admin dev",
    "dev:api": "pnpm --filter @dome/api dev",
    "dev:web": "pnpm --filter @dome/web dev",
    "dev:admin": "pnpm --filter @dome/admin dev",
    "seed": "pnpm --filter @dome/api seed",
    "typecheck": "pnpm -r typecheck",
    "create-admin": "pnpm --filter @dome/api create-admin",
    "demo-data": "pnpm --filter @dome/api demo-data"
  }
}
