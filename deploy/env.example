# API settings for the VPS. Copy to apps/api/.env on the server and fill in the values:
#   cp deploy/env.example apps/api/.env && nano apps/api/.env && chmod 600 apps/api/.env
# Never commit the real file (it is in .gitignore) and never paste it into chat.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). The part after .net/ is the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/somdigitalwebsite?retryWrites=true&w=majority

# Images uploaded in the dashboard. Outside the git checkout so a redeploy never touches them.
UPLOAD_DIR=/home/USER/dome-data/uploads
